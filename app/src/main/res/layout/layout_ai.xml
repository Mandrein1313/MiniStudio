<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#1E1E1E"
    android:padding="8dp">

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_above="@+id/aiInputArea"
        android:fillViewport="true">
        
        <TextView
            android:id="@+id/tvAiOutput"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="ระบบ AI พร้อมช่วยเหลือแล้ว..."
            android:textColor="#FFFFFF"
            android:textSize="14sp" />
    </ScrollView>

    <LinearLayout
        android:id="@+id/aiInputArea"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_alignParentBottom="true"
        android:background="#252526"
        android:padding="6dp"
        android:gravity="center_vertical">

        <EditText
            android:id="@+id/etAiInput"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:hint="พิมพ์ถามระบบ AI Build Doctor..."
            android:textColor="#FFFFFF"
            android:textColorHint="#8C8C8C"
            android:textSize="13sp"
            android:background="@android:color/transparent" />

        <Button
            android:id="@+id/btnSendToAi"
            android:layout_width="wrap_content"
            android:layout_height="36dp"
            android:text="ส่งถาม"
            android:textSize="12sp"
            android:backgroundTint="#BB86FC"
            android:textColor="#1E1E1E" />
    </LinearLayout>

</RelativeLayout>
